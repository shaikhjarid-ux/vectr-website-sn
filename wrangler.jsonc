{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fmhy-safety-auditor",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "FETCH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": { "ENVIRONMENT": "production" }
}
